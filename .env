# QWEN-VALERA Environment Variables
# Copy to .env and customize

# Model
# Работает «из коробки» (без распаковки квантованных весов):
#   Qwen/Qwen2.5-Omni-7B   — 20.8 GB, bf16, голос Ethan, влезает в 61 GB RAM (рекомендуется)
#   Qwen/Qwen2.5-Omni-3B   — 11.2 GB, bf16, быстрее и легче, качество ниже
#
# НЕ подходят на этом железе:
#   cyankiwi/Qwen3-Omni-30B-A3B-Instruct-AWQ-4bit — формат compressed-tensors:
#     transformers материализует веса в fp16 (~60 GB) → не влезает в 61 GB RAM.
#   любые NVFP4/FP8 — нет аппаратных ядер на Ampere (sm_87).
VALERA_MODEL_NAME_OR_PATH=Qwen/Qwen2.5-Omni-7B
VALERA_SPEAKER_VOICE=Ethan
VALERA_ATTN_IMPLEMENTATION=sdpa

# Server
VALERA_API_HOST=0.0.0.0
VALERA_API_PORT=8765

# Generation
# Для голосового ассистента длинные ответы не нужны, а генерация на Jetson
# небыстрая (персона просит ≤50 слов). У Qwen2.5-Omni это thinker_max_new_tokens
# (по умолчанию 1024 — слишком много).
VALERA_MAX_NEW_TOKENS=256

# Голосовой режим: каждая секунда озвучки стоит ~13 с генерации на Jetson,
# поэтому реплика должна быть короткой (~80 токенов ≈ 40-50 слов).
VALERA_VOICE_MAX_NEW_TOKENS=80

# Жёсткий предел длины озвучки (кадры кодек-токенов, ~12.5 кадр/с):
# 400 кадров ≈ 32 с максимум. Страховка от «монологов» на несколько минут.
VALERA_TALKER_MAX_NEW_TOKENS=400

VALERA_TEMPERATURE=0.6

# Search
VALERA_SEARCH_ENABLED=true
VALERA_SEARCH_REGION=ru-ru

# Documents (RAG knowledge base)
VALERA_RAG_ENABLED=true
VALERA_RAG_TOP_K=5
VALERA_CHUNK_SIZE=800
VALERA_CHUNK_OVERLAP=150

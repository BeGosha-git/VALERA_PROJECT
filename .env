# QWEN-VALERA Environment Variables
# Copy to .env and customize

# Model
# Работает «из коробки» (без распаковки квантованных весов):
#   Qwen/Qwen2.5-Omni-7B   — 20.8 GB, bf16, голос Ethan, влезает в 61 GB RAM (рекомендуется)
#   Qwen/Qwen2.5-Omni-3B   — 11.2 GB, bf16, быстрее и легче, качество ниже
#
# НЕ подходят на этом железе:
#   cyankiwi/Qwen3-Omni-30B-A3B-Instruct-AWQ-4bit — формат compressed-tensors:
#     transformers материализует веса в fp16 (~60 GB) → не влезает в 61 GB RAM.
#   любые NVFP4/FP8 — нет аппаратных ядер на Ampere (sm_87).
VALERA_MODEL_NAME_OR_PATH=Qwen/Qwen2.5-Omni-3B
VALERA_SPEAKER_VOICE=Ethan
VALERA_ATTN_IMPLEMENTATION=sdpa

# Server
VALERA_API_HOST=0.0.0.0
VALERA_API_PORT=8765

# Generation
# Для голосового ассистента длинные ответы не нужны, а генерация на Jetson
# небыстрая (персона просит ≤50 слов). У Qwen2.5-Omni это thinker_max_new_tokens
# (по умолчанию 1024 — слишком много).
VALERA_MAX_NEW_TOKENS=96

# Голосовой режим: каждая секунда озвучки стоит ~13 с генерации на Jetson,
# поэтому реплика должна быть короткой (~80 токенов ≈ 40-50 слов).
VALERA_VOICE_MAX_NEW_TOKENS=80

# Жёсткий предел длины озвучки (кадры кодек-токенов, ~12.5 кадр/с):
# 400 кадров ≈ 32 с максимум. Страховка от «монологов» на несколько минут.
VALERA_TALKER_MAX_NEW_TOKENS=400

# ---- Синтез речи (TTS) ----
# Чем озвучивать ответ:
#   russian_tts (ПО УМОЛЧАНИЮ) — Silero v3.1_ru из russian_text_to_speech/.
#                Русский голос, считается на CPU (~2 с на секунду речи),
#                GPU остаётся свободным для языковой модели.
#   model                    — встроенный Talker Qwen2.5-Omni (GPU, медленно).
VALERA_TTS_BACKEND=russian_tts

# Голос Silero: xenia (женский), eugene / aidar / baya (мужские), kseniya, random
VALERA_SILERO_SPEAKER=eugene

# Путь к модели Silero (по умолчанию russian_text_to_speech/model.pt)
VALERA_SILERO_MODEL_PATH=

# ---- Нормализация речи (фильтр из ветки PC) ----
# ASR часто слышит «МИРЭА» как «мир», «мире», «мирэ». При true заменяем на
# «МИРЭА» и обычные падежи слова «мир» — фраза «во всём мире» станет
# «во всём МИРЭА». Обычно нужен только при работе с базой про МИРЭА.
VALERA_MIREA_AGGRESSIVE=false

# ---- Персона ассистента ----
# guide (ПО УМОЛЧАНИЮ) — экскурсовод РТУ МИРЭА: разговорно, кратко, без морали
# mat                  — то же, но с матом для выразительности
# default              — нейтральный помощник без темы университета
VALERA_PERSONA_MODE=mat

# Полный текст промпта. Пусто → берётся встроенный из core/personas.py.
# Промпт должен быть одной строкой (переносы в .env не поддерживаются).
VALERA_SYSTEM_PROMPT=

# Промпт для режима с матом (VALERA_PERSONA_MODE=mat или флаг --mat у клиента)
VALERA_SYSTEM_PROMPT_MAT=

# ---- Язык озвучки встроенным голосом модели (TTS=model) ----
# ВАЖНО (проверено экспериментом): Talker Qwen2.5-Omni-7B НЕ умеет русскую
# речь. Озвученный им русский текст не распознаётся даже самой моделью
# (контроль: Silero-аудио та же модель понимает с первого раза).
# Поэтому для русского используется Silero (VALERA_TTS_BACKEND=russian_tts).
#
# Канонический английский промпт ОБЯЗАТЕЛЕН: с русским промптом Talker
# выдаёт 0.8 с вместо 8 с (процессор предупреждает «audio output may not
# work as expected»). Меняйте эту настройку только для английской озвучки.
VALERA_QWEN_SPEECH_RUSSIAN=false

# Свой канонический промпт (пусто → берётся из core/personas.py)
VALERA_QWEN_SYSTEM_PROMPT=

VALERA_TEMPERATURE=0.6

# Search
VALERA_SEARCH_ENABLED=true
VALERA_SEARCH_REGION=ru-ru

# Documents (RAG knowledge base)
VALERA_RAG_ENABLED=true
VALERA_RAG_TOP_K=5
VALERA_CHUNK_SIZE=800
VALERA_CHUNK_OVERLAP=150
VALERA_MODEL_DTYPE=float16

# ================================================
# Настройки голосового ассистента «Валера»
# Скопируйте в .env и отредактируйте под себя
# ================================================

# --- Аудио / VAD ---
# Устройство ЗАХВАТА (микрофон) — имя из `arecord -L`
AUDIO_DEVICE=default
# Устройство ВОСПРОИЗВЕДЕНИЯ (колонки) — имя из `aplay -L`
# Можно задать и в веб-пульте/настольном GUI (вкладка «Устройства и сеть»)
OUTPUT_DEVICE=default
# Сетевой интерфейс для связи с роботом Unitree H1 ('auto' = не задавать)
NETWORK_INTERFACE=auto
# Порог VAD (0..1, ниже = чувствительнее) — ручной режим
VAD_THRESHOLD=0.3
# Пауза тишины перед завершением фразы (сек)
SILENCE_TIMEOUT_SEC=0.75
# Минимальная длительность фразы (сек)
MIN_SPEECH_DURATION_SEC=0.5
# Шумоподавление (true/false)
NOISE_REDUCTION=true
# Длительность записи профиля шума (сек)
NOISE_PROFILE_DURATION=1.5
# Паддинг вокруг фразы — не даёт срезать первый/последний слог (сек)
PHRASE_PADDING_SEC=0.3
# Максимальная длительность одной фразы — защита от «залипания» (сек)
MAX_PHRASE_DURATION_SEC=20.0

# --- Рантайм-состояние (общее с GUI) ---
# Файл, в котором GUI хранит тумблеры, триггеры и настройки чувствительности.
# Если не указан — valera_config.json рядом с voice_assistant.py
# VALERA_CONFIG=./valera_config.json

# --- WebRAgent (RAG) ---
RAG_BASE_URL=http://localhost:5000
RAG_USERNAME=admin
# !!! ОБЯЗАТЕЛЬНО смените пароль в продакшене !!!
RAG_PASSWORD=change_me_in_production
# Имя коллекции с базой знаний МИРЭА (её создаёт ./run_all.sh kb-ingest)
RAG_COLLECTION_NAME=МИРЭА

# --- TTS ---
# Голос: eugene, xenia, aidar, baya, kseniya
TTS_SPEAKER=eugene
TTS_SAMPLE_RATE=48000

# --- Пересказ ответов через ИИ (Ollama) ---
# Сырые ответы RAG пересказываются этой моделью в живой голосовой текст
OLLAMA_URL=http://localhost:11434
REPHRASE_MODEL=true_valera:latest

# --- Робот Unitree H1 (триггеры «слово → сетевая команда») ---
# Адрес API робота. Подставляется в команды правил вместо {robot},
# а также правится в веб-пульте/GUI (вкладка «Триггеры»).
VALERA_ROBOT_URL=http://192.168.123.161:8080

# --- Веб-пульт (valera_web.py) ---
# Порт «невзрачного» вида — случайный прохожий в браузере его не угадает
VALERA_WEB_PORT=8137
# Адрес: 127.0.0.1 — только с этого компьютера, 0.0.0.0 — из локальной сети
VALERA_WEB_HOST=127.0.0.1

# =============================================================================
# Локальная модель Qwen2.5-Omni (замена Ollama) — основной провайдер
# =============================================================================
# Адрес нашего FastAPI-сервера из корня проекта (python main.py).
# Именно он держит Qwen2.5-Omni-7B в памяти GPU.
VALERA_API_BASE=http://localhost:8765/api/v1
# Таймаут одного запроса к модели, сек (на Jetson инференс небыстрый).
VALERA_TIMEOUT=600
# Имя модели (для отображения в админке)
VALERA_MODEL_NAME_OR_PATH=Qwen/Qwen2.5-Omni-7B

# LLM Provider Configuration

# API Keys for LLM Providers (only needed for the selected provider), choose min one.
#OPENAI_API_KEY=your_openai_api_key_here
#CLAUDE_API_KEY=your_claude_api_key_here

# Ollama — больше НЕ нужен: его роль выполняет локальная Qwen2.5-Omni.
# Оставлено для совместимости.
#OLLAMA_HOST=http://localhost:11434

# Qdrant Configuration
# Если сервер Qdrant недоступен (например, нет Docker), клиент
# автоматически перейдёт на локальное хранилище ниже.
QDRANT_HOST=localhost
QDRANT_PORT=6333
#QDRANT_LOCAL_PATH=data/qdrant_storage

# SearXNG Configuration (для веб-поиска; без него работает обычный поиск)
SEARXNG_URL=http://localhost:8080
SEARXNG_RESULTS_PER_PAGE=10

# Deep Web Search Configuration
DEEP_SEARCH_MAX_URLS=5
DEEP_SEARCH_PARALLEL=True
DEEP_SEARCH_MAX_WORKERS=3

# Web Scraper Configuration
SCRAPER_USER_AGENT_MODE=rotate  # Can be 'fixed' or 'rotate'
SCRAPER_USER_AGENT=RAGSystem/1.0 (+ragfromscratch)
SCRAPER_RATE_LIMIT=1.0  # Seconds between requests
SCRAPER_TIMEOUT=10  # Seconds
SCRAPER_MAX_CONTENT_LENGTH=100000  # Characters

# Deep Web Search Configuration
DEEP_SEARCH_MAX_URLS=5
DEEP_SEARCH_PARALLEL=True
DEEP_SEARCH_MAX_WORKERS=3

# Flask Secret Key (generate a secure random key for production)
FLASK_SECRET_KEY=change_me_in_production

# MongoDB Configuration
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DB=ragapp
MONGODB_COLLECTION_CHATS=chat_history
MONGODB_COLLECTION_MESSAGES=chat_messages

# Admin User Configuration
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_in_production

# Login Page Configuration
# Set to true to use random background images from static/images/backgrounds/ directory
# Set to false for default gradient background
LOGIN_USE_BACKGROUND_IMAGES=true